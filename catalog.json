  "topics": [
    {
      "id": "foundations",
      "name": "The Map of the Psyche",
      "tagline": "Jung's core model, from the ground up",
      "journey": [
        "001 - Life",
        "002 - Archetypes & The Collective Unconscious",
        "059 - On Archetypes",
        "006 - Dynamics of the Psyche",
        "005 - A History of Consciousness",
        "044 - On Consciousness",
        "034 - On Complexes",
        "037 - On Associations",
        "012 - Perception & Experience",
        "041 - On Reality",
        "033 - What Makes an Idea Jungian",
        "003 - Neurosis, Hysteria, Psychosis, Schizophrenia"
      ],
      "about": "Jung's model of the mind, built from the ground up: how consciousness rises out of something far older, how complexes and associations shape what you perceive, and why the parts you neglect never stop working. By the end, the vocabulary the whole podcast speaks is yours: archetypes, complexes, the collective unconscious."
    },
    {
      "id": "types",
      "name": "Types & Functions",
      "tagline": "Introverts, extraverts, and the function you never trained",
      "journey": [
        "007 - Typology & Personality",
        "063 - On Introversion & Extraversion",
        "029 - On Intuition",
        "060 - On the Inferior Function",
        "053 - Logos & Eros",
        "048 - On Irrationality"
      ],
      "about": "Jung's map of how people differ: the two attitudes, the four functions, and the inferior one that trips you up at exactly the wrong moment. Intuition and the irrational get their due, and logos and eros show how the differences play out between people. Useful the day after you hear it."
    },
    {
      "id": "shadow-self",
      "name": "Shadow, Self & Individuation",
      "tagline": "The inner cast of characters and the path to wholeness",
      "journey": [
        "017 - Shadow & Projection",
        "056 - A Shadow of Doubt",
        "030 - On Evil",
        "039 - On The Other",
        "016 - Inflation & Possession",
        "024 - Persona & Groups",
        "032 - On Puer Aeternus",
        "015 - Individuation",
        "018 - The Self & Mandala",
        "014 - Symbols & The Third"
      ],
      "about": "The inner cast of characters: the shadow you'd rather not own, the persona you show the world, the other that speaks with your voice. This is the path Jung called individuation: the slow negotiation between everything you are, aimed at the Self that holds it together."
    },
    {
      "id": "dreams-symbols",
      "name": "Dreams, Symbols & the Numinous",
      "tagline": "Where the unconscious speaks: dreams, alchemy, synchronicity",
      "journey": [
        "011 - Dreams",
        "042 - On Fantasy",
        "009 - Alchemy & Active Imagination",
        "061 - On the Alchemical Process",
        "010 - Synchronicity & Astrology (& Aions)",
        "049 - Physics & Numbers",
        "040 - On Aions",
        "054 - On Tarot",
        "052 - On UFOs",
        "013 - The Creative Spirit",
        "057 - Dancing & Movement",
        "050 - Rebirth & Resurrection"
      ],
      "about": "Where the unconscious speaks in its own language: dreams, symbols, alchemy, synchronicity. The strange territory Jung refused to abandon to superstition. Expect the mystical taken seriously and examined carefully, from active imagination to tarot and UFOs."
    },
    {
      "id": "movies",
      "name": "Jung at the Movies",
      "tagline": "Film analyses through a Jungian lens",
      "journey": [
        "019 - Movie Analysis: Barbie",
        "022 - Movie Analysis: Fight Club",
        "025 - Movie Analysis: Titanic",
        "027 - Movie Analysis: Jaws",
        "043 - Movie Analysis: American Psycho",
        "045 - Movie Analysis: Runaway Bride",
        "047 - Movie Analysis: Scarface",
        "055 - Movie Analysis: The Matrix"
      ],
      "about": "Jung at the cinema: eight films read through his ideas, from the shadow burning through Fight Club to the persona with nothing behind it in American Psycho. The lightest door into the concepts: you already know these stories; now watch them confess their psychology."
    },
    {
      "id": "everyday",
      "name": "Jung in Everyday Life",
      "tagline": "Relationships, family, body, nature, and the self-help question",
      "journey": [
        "008 - Mother, Father, Child",
        "036 - On Children",
        "051 - On Relationships",
        "031 - On the Body",
        "035 - On Nature",
        "038 - On Secrets",
        "046 - Suffering & Sacrifice",
        "058 - The Self-Help Jung",
        "026 - Analytical Psychology & Therapy"
      ],
      "about": "Jung off the page and in a life: family and childhood, relationships, the body, nature, suffering, and what therapy and self-help can honestly promise. Where the theory has to prove it can help an actual Tuesday."
    },
    {
      "id": "jung",
      "name": "Jung Himself",
      "tagline": "The man himself: his books, his quarrels, his patients",
      "journey": [
        "004 - All The Books",
        "020 - Jung vs. Freud",
        "023 - The Misunderstood Jung",
        "028 - Where I struggle with Jung",
        "021 - The East & The West",
        "062 - The Patients of Jung"
      ],
      "about": "Jung the man, not the model: which books to read and in what order, the break with Freud, the ways he is misread and the places where even his host disagrees with him, his view of East and West, and the patients whose stories carry his ideas. For when you want to know who was talking."
    }
  ],
